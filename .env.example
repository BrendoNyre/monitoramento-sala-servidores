# =====================================================================
# MODELO do arquivo .env
# ---------------------------------------------------------------------
# Por que existe: o .env guarda tudo que é SEGREDO (senhas, token) ou
# que muda de casa para casa (IPs). Ele NUNCA vai para o Git.
# Este .env.example é a "planta" dele: mostra quais variáveis existem,
# mas sem os valores reais. Para começar: copie para .env e preencha.
# =====================================================================

# ---------- Rede ----------
# IP deste computador (o "notebook normal") na rede local.
# O agente do servidor monitorado e o ESP32 vão falar com este IP.
ZABBIX_HOST_IP=192.168.0.10

# IP do ESP32 (reserve no roteador para ele não mudar).
ESP32_IP=192.168.0.50

# IP do servidor monitorado (o SRV-01): o celular com Termux (veja
# celular/README.md) ou um notebook.
NOTEBOOK_VELHO_IP=192.168.0.20

# Sistema do servidor: linux, windows ou android (celular com Termux;
# usa o template do Linux com filtros para o que o Android esconde).
NOTEBOOK_VELHO_SO=linux

# Como os hosts APARECEM no painel e no Telegram (o nome técnico continua
# notebook-velho / esp32-sala por dentro, que é o que o agente usa).
SERVIDOR_NOME_EXIBICAO=SRV-01
ESP32_NOME_EXIBICAO=Sensores da sala

# ---------- Banco de dados (PostgreSQL usado pelo Zabbix) ----------
# Só os containers usam essa senha; troque por algo aleatório.
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=zabbix

# ---------- Zabbix web ----------
# Usuário padrão é Admin. Depois de trocar a senha na tela do Zabbix,
# coloque a senha nova aqui (o zabbix/configurar.py usa para falar com a API).
ZABBIX_USER=Admin
ZABBIX_PASSWORD=

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# ---------- Telegram ----------
# Token do bot criado no @BotFather e o ID do seu chat.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Banco e aplicação no SRV-01 (celular) ----------
# Senhas do PostgreSQL que roda no celular. Gere valores aleatórios.
PG_ADMIN_SENHA=troque-por-uma-senha-aleatoria      # superusuário "postgres"
LOJA_DB_SENHA=troque-por-uma-senha-aleatoria       # usuário da aplicação Loja
PG_MONITOR_SENHA=troque-por-uma-senha-aleatoria    # usuário só-leitura do Zabbix (papel pg_monitor)

# ---------- SRV-02 (containers no Docker do PC) ----------
LOJA2_DB_SENHA=troque-por-uma-senha-aleatoria   # banco da Loja em container

# ---------- Ações da central (acoes/acoes.py) ----------
# Senha do usuário restrito "central-acoes" no Zabbix (criado pelo
# zabbix/configurar.py). Só pode reconhecer/comentar alertas e abrir
# manutenção; nunca vai para o navegador.
ACOES_ZABBIX_SENHA=troque-por-uma-senha-aleatoria
# Usuário zbx_acoes do PostgreSQL do celular (SRV-01): só encerra conexões
# ociosas. Vai também para o ~/srv01.env do celular (celular/7-acoes.sh).
ACOES_PG_SENHA=troque-por-uma-senha-aleatoria
